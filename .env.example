# Both published ports are restricted to host loopback.
DEVHUB_PORT=8787
DEVHUB_REMOTE_VAULT_PORT=8788

# Runtime mount for the public listener only. The gateway preserves this path.
# Changing it needs docker compose up -d, never a frontend/image rebuild.
DEVHUB_BASE_PATH=/

# The gateway terminates TLS and overwrites X-Forwarded-Proto: https.
DEVHUB_REQUIRE_HTTPS=1
TZ=Asia/Shanghai
