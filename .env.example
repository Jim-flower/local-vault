# Both published ports are restricted to host loopback.
DEVHUB_PORT=8787
DEVHUB_REMOTE_VAULT_PORT=8788

# Runtime mount for the public listener only. The gateway preserves this path.
# Changing it needs docker compose up -d, never a frontend/image rebuild.
DEVHUB_BASE_PATH=/

# The gateway terminates TLS and overwrites X-Forwarded-Proto: https.
DEVHUB_REQUIRE_HTTPS=1

# Login 2FA is enabled by default in Compose. Generate a secret before startup:
# docker compose build app
# docker compose run --rm --no-deps app -generate-login-2fa-secret
# Add that Base32 key to your phone authenticator (SHA1 / 6 digits / 30 seconds)
# and paste it here. Never enter the changing six-digit code in this setting.
DEVHUB_REQUIRE_LOGIN_2FA=1
DEVHUB_ADMIN_TOTP_SECRET=
TZ=Asia/Shanghai
