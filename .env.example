# Port exposed only on the Mac loopback interface.
DEVHUB_PORT=8787

DEVHUB_REMOTE_VAULT_PORT=8788

# Absolute macOS path containing the projects shown in Workspace.
# If omitted, Compose mounts this repository's parent directory.
DEVHUB_PROJECTS_DIR=/Users/your-name/Projects

# Optional public URL prefix for gateway routing. Keep / for direct access.
# DEVHUB_BASE_PATH=/vault/

TZ=Asia/Shanghai
